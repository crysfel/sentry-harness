# Copy to .env (chmod 600). .env is git-ignored. Secrets never go in SQLite, logs or prompts.

# Fine-grained GitHub token limited to the registered repositories:
# Contents: read/write, Pull requests: read/write (nothing else). Used only by harness code (git over HTTPS, gh).
HARNESS_GITHUB_TOKEN=

# Read-only Sentry user auth token (scopes: org:read, project:read, event:read) for the local Sentry MCP server.
SENTRY_AUTH_TOKEN=
# SENTRY_HOST=sentry.io

# More Sentry accounts (e.g. one per client): one token per account, same read-only scopes.
# The suffix becomes the connection name you pick per project ("acme" below).
# SENTRY_AUTH_TOKEN_ACME=
# SENTRY_HOST_ACME=sentry.io

# From `claude setup-token` on the deployment machine. Unset = use the machine's interactive Claude Code login.
# Do NOT set ANTHROPIC_API_KEY for the worker: it would bill the API instead of the subscription.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_BIN=claude

# Dashboard. Bound to localhost by default; set a password before binding to anything else (Tailscale).
# DASHBOARD_HOST=127.0.0.1
# PORT=3100
DASHBOARD_PASSWORD=

# Optional
# LOG_LEVEL=info
# HARNESS_DATA_DIR=data
# AGENT_TIMEOUT_MINUTES=45
# TRIAGE_TIMEOUT_MINUTES=30
