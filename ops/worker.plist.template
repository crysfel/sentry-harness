<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.sentry-harness.worker</string>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ROOT__/node_modules/tsx/dist/cli.mjs</string>
    <string>src/worker/index.ts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd does not load the shell profile: PATH must list node, claude, gh, git, xcrun. -->
    <key>PATH</key><string>__PATH__</string>
    <key>HOME</key><string>__HOME__</string>
    <key>NODE_ENV</key><string>production</string>
    <key>CLAUDE_BIN</key><string>__CLAUDE__</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <!-- Secrets come from __ROOT__/.env (mode 600), loaded by the worker. Never ANTHROPIC_API_KEY. -->
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>StandardOutPath</key><string>__ROOT__/data/logs/worker.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/worker.err.log</string>
</dict>
</plist>
